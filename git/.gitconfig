# Git configuration
# Identity lives in ~/.gitconfig.local (created by install.sh, never committed).

[include]
	path = ~/.gitconfig.local
	path = ~/.config/delta/catppuccin.gitconfig

# Per-directory identity override example (add to ~/.gitconfig.local):
# [includeIf "gitdir:~/workspace/"]
#	path = ~/.gitconfig.work

[core]
	editor = nvim
	pager = delta
	autocrlf = input

[init]
	defaultBranch = main

[pull]
	rebase = true

[push]
	default = simple
	autoSetupRemote = true
	followTags = true

[fetch]
	prune = true

[rebase]
	autoStash = true

[merge]
	conflictstyle = zdiff3

[diff]
	colorMoved = default

[branch]
	sort = -committerdate

[rerere]
	enabled = true

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	line-numbers = true
	features = catppuccin-mocha

[alias]
	st = status
	co = checkout
	br = branch
	ci = commit
	unstage = reset HEAD --
	last = log -1 HEAD
	amend = commit --amend --no-edit
	undo = reset --soft HEAD^
	lg = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit
	lga = log --graph --all --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit
